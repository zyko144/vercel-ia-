# ===== OBLIGATOIRE =====
# Token du bot : https://discord.com/developers/applications > ton app > Bot > Reset Token
# Token du bot. Pour l'IA vocale (2e bot), mets les deux séparés par ; : token_principal;token_ia_vocale
DISCORD_TOKEN=
# Modèle de l'IA vocale (gemini-3.8-live répond quasi instantanément)
# GEMINI_VOICE_MODEL=gemini-3.8-live
# Salon vocal de l'IA vocale (le bot musique reste dans VOICE_CHANNEL_ID)
# VOICE_AI_CHANNEL_ID=1550196141902008340
# Comptes autorisés à utiliser /vocal (séparés par des virgules, vide = tout le monde)
# VOICE_AI_USERS=855176142096039997,734865069904756766,923551925113323542
# Clé Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ===== LE CHEF =====
OWNER_ID=1543726919168557087
# Membres protégés contre les insultes en plus du chef (warn, puis exclusion 1 min dès le 2e)
# PROTECTED_USERS=923551925113323542

# ===== MODÈLES GEMINI (offre gratuite) =====
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high (le code, les quiz et /explique expert passent en high tout seuls)
GEMINI_THINKING_LEVEL=medium
# Recherche Google : bloquée sur l'offre gratuite, mettre true si la facturation est activée
GEMINI_WEB_SEARCH=false

# ===== IMAGES (payant : facturation Google AI Studio obligatoire) =====
IMAGES_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_PRO_MODEL=gemini-3-pro-image
IMAGE_DAILY_LIMIT=5
PRO_IMAGE_OWNER_ONLY=true

# ===== VOCAL 24h/24 =====
VOICE_ENABLED=true
VOICE_CHANNEL_ID=1550190587142082582
# Le bot reste TOUJOURS dans VOICE_CHANNEL_ID (musique et mini-jeux compris)
VOICE_LOCK_HOME=true
# Le bot suit le chef (OWNER_ID) dans chaque vocal (ignoré si VOICE_LOCK_HOME=true)
VOICE_FOLLOW_OWNER=false
# Utilisés seulement si VOICE_CHANNEL_ID est vide
VOICE_CATEGORY_NAME=vercel
VOICE_CHANNEL_NAME=bureau

# ===== SALONS =====
# Salons où le bot répond à TOUS les messages (sans mention)
AI_CHANNEL_IDS=1550195587922661607
# Vide = le bot marche dans tous les salons. Rempli = il ne répond que dans ceux-là.
ALLOWED_CHANNEL_IDS=
# Salons "jukebox" : y écrire un nom de son l'ajoute direct à la file
JUKEBOX_CHANNEL_IDS=1550197426391097445
# Salon des blind tests (vide = là où la commande est tapée)
BLINDTEST_CHANNEL_ID=1550197427573755924
# Salons des jeux : parties /jeu-films, /jeu-disney... et mini-jeux (quiz, pile ou face, dés visibles par tous)
# GAMES_DEVINE_CHANNEL_ID=1550204552588951633
# GAMES_MINI_CHANNEL_ID=1550204553578942469
# Salon où arrivent les signalements (vide = MP au chef)
STAFF_CHANNEL_ID=
# Réponses visibles seulement par la personne (fil privé + commandes en "visible que par toi")
PRIVATE_REPLIES=true
# Statut affiché sous le nom du bot
BOT_STATUS=dictature

# ===== MUSIQUE =====
# auto = serveurs audio Lavalink si dispo, sinon lecteur local · lavalink · local
MUSIC_ENGINE=auto
# Serveurs audio (JSON). Vide = liste par défaut. Listes à jour : https://lavalink.darrennathanael.com/
LAVALINK_NODES=
# Rafraîchissement de la barre de progression, en secondes (3 minimum, Discord limite les modifications)
MUSIC_PANEL_REFRESH_SECONDS=4
# Décalage des paroles en ms : négatif = elles s'affichent plus tard (le son a du retard sur la position)
LYRICS_OFFSET_MS=-900
# Si YouTube bloque l'hébergeur : proxy HTTP (résidentiel de préférence) et/ou cookies d'un compte Google secondaire (cookies.txt en base64)
MUSIC_PROXY=
YTDLP_COOKIES=

# ===== ANTI-SPAM =====
CHAT_COOLDOWN_SECONDS=3
ESCALATION_COOLDOWN_MINUTES=10

# ===== SUPABASE (optionnel, conseillé sur Render gratuit) =====
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
